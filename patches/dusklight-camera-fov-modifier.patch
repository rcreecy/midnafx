+bool run_fov_modifiers(
+    dCamera_c* camera, view_class* view, const bool demoActive, const bool detached) {
+    auto* mainCamera = dComIfGp_getCamera(0);
+    if (camera == nullptr || view == nullptr || mainCamera == nullptr ||
+        &mainCamera->mCamera != camera || !std::isfinite(view->fovy))
+    {
+        return false;
+    }
+
+    uint32_t flags = 0;
+    if (camera->Active()) {
+        flags |= CAMERA_FOV_CONTEXT_ACTIVE;
+    }
+    if (camera->Mode() == 0) {
+        flags |= CAMERA_FOV_CONTEXT_NORMAL_MODE;
+    }
+    if (demoActive) {
+        flags |= CAMERA_FOV_CONTEXT_DEMO;
+    }
+    if (detached) {
+        flags |= CAMERA_FOV_CONTEXT_DETACHED;
+    }
+    if (camera->Active() && !demoActive && !detached) {
+        flags |= CAMERA_FOV_CONTEXT_CAN_MODIFY;
+    }
+
+    struct PendingModifier {
+        CameraFovModifierHandle handle;
+        CameraFovModifier value;
+        LoadedMod* owner;
+    };
+    std::vector<PendingModifier> modifiers;
+    sFovModifiers.for_each([&](CameraFovModifierHandle handle, const auto& entry) {
+        modifiers.push_back({.handle = handle, .value = entry.value, .owner = entry.owner});
+    });
+    std::ranges::sort(modifiers, [](const PendingModifier& lhs, const PendingModifier& rhs) {
+        if (lhs.value.priority != rhs.value.priority) {
+            return lhs.value.priority > rhs.value.priority;
+        }
+        return lhs.value.sequence < rhs.value.sequence;
+    });
+
+    const CameraFovModifierState initialState{
+        .struct_size = sizeof(CameraFovModifierState),
+        .frame_counter = camera->mFrameCounter,
+        .ticks = camera->mTicks,
+        .aspect = view->aspect,
+        .native_fovy = view->fovy,
+        .camera_type = camera->Type(),
+        .camera_mode = camera->Mode(),
+        .context_flags = flags,
+        .fovy = view->fovy,
+    };
+    for (const auto& entry : modifiers) {
+        if (!entry.owner->active || sFovModifiers.find(entry.handle) == nullptr) {
+            continue;
+        }
+
+        auto state = initialState;
+        bool useState = false;
+        try {
+            useState = entry.value.modify(
+                entry.owner->context.get(), &state, entry.value.userData);
+        } catch (const std::exception& e) {
+            fail_mod(*entry.owner, MOD_ERROR,
+                fmt::format("exception in camera FOV modifier '{}': {}",
+                    entry.value.debugName, e.what()));
+        } catch (...) {
+            fail_mod(*entry.owner, MOD_ERROR,
+                fmt::format("unknown exception in camera FOV modifier '{}'",
+                    entry.value.debugName));
+        }
+
+        if (!useState || (flags & CAMERA_FOV_CONTEXT_CAN_MODIFY) == 0 ||
+            !std::isfinite(state.fovy))
+        {
+            continue;
+        }
+        view->fovy = std::clamp(state.fovy, 10.0f, 120.0f);
+        return true;
+    }
+    return false;
+}
+
 void camera_mod_detached(LoadedMod& mod) {
     sOperators.erase_all(mod);
+    sFovModifiers.erase_all(mod);
 }
 

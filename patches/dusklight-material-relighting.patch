+ModResult set_material_relighting(ModContext* context, uint32_t enabled) {
+    auto* mod = mod_from_context(context);
+    if (mod == nullptr || enabled > 1) return MOD_INVALID_ARGUMENT;
+    if (s_materialOwner != nullptr && s_materialOwner != mod) return MOD_CONFLICT;
+    if (!enabled && s_materialOwner == nullptr) return MOD_OK;
+    s_materialOwner = enabled ? mod : nullptr;
+    if (!enabled) record_material_scope(false);
+    return MOD_OK;
+}
+
+void material_mod_detached(LoadedMod& mod) {
+    if (s_materialOwner != &mod) return;
+    s_materialOwner = nullptr;
+    record_material_scope(false);
+}

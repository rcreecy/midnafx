     return nullptr;
   }
+  // A trace scope cannot inherit vertices from another scope through batching.
+  const auto traced = [](const auto& stack) {
+    return std::any_of(stack.begin(), stack.end(), [](const auto& label) {
+      return label.starts_with("MidnaFXAssetV1:");
+    });
+  };
+  if ((traced(last.debugGroupStack) || traced(g_recorder.debugGroupStack)) &&
+      last.debugGroupStack != g_recorder.debugGroupStack) return nullptr;
   return &inline_payload<gx::DrawData>(last.data.draw.payload.data());
 }
 

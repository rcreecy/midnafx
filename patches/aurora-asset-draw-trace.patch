--- a/lib/gfx/encoding.hpp
+++ b/lib/gfx/encoding.hpp
@@ -4,6 +4,10 @@
 
 namespace aurora::gfx {
 
+// Borrowed only while a copied frame command is synchronously encoded.
+extern thread_local const char* asset_trace_label;
+extern thread_local uint64_t asset_trace_frame;
+
 bool bind_pipeline(PipelineRef ref, const wgpu::RenderPassEncoder& pass);
 

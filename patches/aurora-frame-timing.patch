+  g_timingBeginAttempts = g_timingFailedBegins = g_timingIncompleteBegins = 0;
+  g_pendingProducerTiming = {};
+  g_producerTimingPending = false;
+  g_timingPresentFrameId = 0;
+  g_timingLastPresentNs = 0;

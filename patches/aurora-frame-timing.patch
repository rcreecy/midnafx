+      "\"present\":\"Successful Surface.Present call completion; not physical scanout\","
+      "\"failed_begin\":\"Counted separately; no frame ID or producer row is assigned\","
+      "\"first_present_interval\":\"null; later intervals use consecutive successful call completions\","
+      "\"encoding_time\":null,\"gpu_time\":null,\"heap_allocations\":null},"
+      "\"capacity_per_stream\":%zu,\"producer_count\":%zu,\"producer_dropped\":%llu,"
+      "\"present_count\":%zu,\"present_dropped\":%llu,\"begin_attempts\":%llu,"
+      "\"failed_begins\":%llu,\"incomplete_begins\":%llu,\"truncated\":%s,\"producer\":[",
+      FrameTimingCapacity, g_producerTimingCount, static_cast<unsigned long long>(g_producerTimingDropped),
+      g_presentTimingCount, static_cast<unsigned long long>(g_presentTimingDropped),
+      static_cast<unsigned long long>(g_timingBeginAttempts), static_cast<unsigned long long>(g_timingFailedBegins),
+      static_cast<unsigned long long>(g_timingIncompleteBegins),
+      g_producerTimingDropped || g_presentTimingDropped ? "true" : "false");
+  for (size_t i = 0; i < g_producerTimingCount; ++i) {
+    const auto& row = g_producerTimings[i];
+    std::fprintf(output,
+        "%s{\"frame_id\":%llu,\"begin_entry_ns\":%lld,\"acquisition_complete_ns\":%lld,"
+        "\"record_start_ns\":%lld,\"end_entry_ns\":%lld,\"end_enqueue_complete_ns\":%lld}",
+        i ? "," : "", static_cast<unsigned long long>(row.frameId),
+        static_cast<long long>(row.beginEntryNs), static_cast<long long>(row.acquisitionCompleteNs),
+        static_cast<long long>(row.recordStartNs), static_cast<long long>(row.endEntryNs),
+        static_cast<long long>(row.endEnqueueCompleteNs));
+  }
+  std::fputs("],\"present\":[", output);
+  for (size_t i = 0; i < g_presentTimingCount; ++i) {
+    const auto& row = g_presentTimings[i];
+    std::fprintf(output, "%s{\"frame_id\":%llu,\"completion_ns\":%lld,\"interval_ns\":",
+                 i ? "," : "", static_cast<unsigned long long>(row.frameId), static_cast<long long>(row.completionNs));
+    if (row.intervalNs < 0) std::fputs("null", output);
+    else std::fprintf(output, "%lld", static_cast<long long>(row.intervalNs));
+    std::fputc('}', output);
+  }
+  std::fputs("]}\n", output);
+  const bool failed = std::ferror(output) != 0;
+  const int closeResult = std::fclose(output);
+  if (failed || closeResult != 0) Log.warn("Could not finish frame timing output: {}", g_frameTimingOutput);
+  g_frameTimingOutput.clear();
